{
  "app": {
    "name": "优墨",
    "description": "结合AI Agent能力的桌宠",
    "introduction": "基于 Electron + Vue 3 + Python 构建的桌宠",
    "version": "1.0.0",
    "logo": "🤖"
  },
  "agent": {
    "memoryWindow": 50,
    "recursionLimit": 50,
    "ocrEngine": "markitdown"
  },
  "rag": {
    "autoEmbedding": true,
    "embeddingModel": {
      "type": "local",
      "model": "BAAI/bge-small-zh-v1.5",
      "baseUrl": "",
      "apiKey": "",
      "downloaded": false,
      "localPath": ""
    },
    "ocrEngine": "docling"
  },
  "pet": {
    "quickAsk": {
      "shortcut": "Alt+Shift+Q"
    },
    "reminders": {
      "pollIntervalSeconds": 5,
      "bubbleDurationMs": 8000
    }
  },
  "network": {
    "proxy": {
      "enabled": false,
      "http": "",
      "https": "",
      "noProxy": ""
    }
  },
  "links": [
    { "label": "项目主页", "url": "https://gitee.com/zjwan461/sassy-cat" },
    { "label": "使用文档", "url": "https://gitee.com/zjwan461/sassy-cat/blob/master/README.md" },
    { "label": "更新日志", "url": "https://gitee.com/zjwan461/sassy-cat/releases" },
    { "label": "反馈问题", "url": "https://gitee.com/zjwan461/sassy-cat/issues" }
  ],
  "pythonVersion": "3.11.9"
}
